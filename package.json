{
  "name": "skillsetu-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SkillSetu - AI-Powered Industry-Academia Bridging and Competency-to-Opportunity Graph Matching Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "npm --prefix apps/web run build",
    "test:api": "cd apps/api && python -m pytest",
    "lint": "npm run --workspaces --if-present lint"
  },
  "keywords": [
    "sih",
    "competency-graph",
    "neo4j",
    "fastapi",
    "nextjs",
    "ai-matching"
  ],
  "author": "SkillSetu Team",
  "license": "MIT"
}
