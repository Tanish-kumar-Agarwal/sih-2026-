# App Configuration
ENVIRONMENT=development
APP_NAME=SkillSetu
APP_VERSION=1.0.0
DEBUG=True

# Backend Security
SECRET_KEY=skillsetu_dev_secret_key_at_least_32_characters_sih2026
JWT_SECRET=skillsetu_super_secret_jwt_key_sih26
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL (Relational Source of Truth)
DATABASE_URL=postgresql+asyncpg://skillsetu_user:skillsetu_password@localhost:5432/skillsetu_db
SYNC_DATABASE_URL=postgresql://skillsetu_user:skillsetu_password@localhost:5432/skillsetu_db

# Neo4j (Graph Relationship Intelligence)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skillsetu_graph_pass

# Redis (Caching & Task Broker)
REDIS_URL=redis://localhost:6379/0

# AI Provider / LLM
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# Frontend URL
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
